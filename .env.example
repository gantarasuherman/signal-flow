# =============================================================
# SignalFlow — salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
# =============================================================

# ---------- Umum ----------
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta

# ---------- PostgreSQL ----------
POSTGRES_USER=signalflow
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=signalflow

# ---------- Data provider ----------
# twelvedata | mock (mock = data sintetis untuk uji tanpa API key)
DATA_PROVIDER=twelvedata
# Daftar gratis di https://twelvedata.com/ lalu salin API key dari dashboard
TWELVEDATA_API_KEY=
# Batas paket gratis: 8 request/menit, 800 request/hari
TWELVEDATA_RATE_LIMIT_PER_MIN=8
TWELVEDATA_DAILY_LIMIT=800
# Kuota harian yang dicadangkan untuk worker (live candle berhenti bila sisa kuota <= nilai ini)
TWELVEDATA_RESERVED_DAILY=300
# Interval refresh live candle (detik). Makin kecil makin boros kuota.
LIVE_REFRESH_SECONDS=20

# ---------- Scheduler ----------
# Jeda (detik) setelah candle M15 ditutup sebelum analisis dijalankan,
# memberi waktu provider memfinalkan candle.
SCHEDULER_DELAY_SECONDS=10

# ---------- Saran ukuran lot ----------
# % risiko default per sinyal (modal diisi di dashboard)
DEFAULT_RISK_PERCENT=1.0

# ---------- Port ----------
# Dashboard + API + WebSocket lewat satu alamat: http://localhost:APP_PORT
# Dari HP di Wi-Fi yang sama: http://<IP-laptop>:APP_PORT
APP_PORT=8080
# Port langsung ke backend (Swagger: http://localhost:8000/docs)
BACKEND_PORT=8000
# Origin lain yang boleh memanggil API langsung (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:8080

# ---------- AI penjelasan sinyal (opsional, Groq) ----------
# Dipakai hanya untuk merangkai alasan sinyal dalam bahasa Indonesia.
# Kosongkan untuk memakai alasan berbasis aturan saja. Key: https://console.groq.com/keys
# Hanya analisis instrumen yang sedang dibuka di dashboard (+ yang masih punya posisi aktif).
# Hemat kuota data & AI. false = analisis semua instrumen tiap 15 menit.
ANALYZE_WATCHED_ONLY=true
# Sinyal AI Groq berdampingan dengan strategi (eksperimen). false = matikan
AI_SIGNALS_ENABLED=true
# Jeda antar panggilan AI per instrumen (detik) agar tidak melewati batas token Groq
AI_CALL_GAP_SECONDS=15
GROQ_MODEL=openai/gpt-oss-120b
# low / medium / high untuk model reasoning (gpt-oss, qwen3); kosongkan untuk model lain
GROQ_REASONING_EFFORT=low
GROQ_API_KEY=
